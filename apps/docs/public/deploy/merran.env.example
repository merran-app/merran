# Starter settings for the project's compose.yaml on SQLite.
# Save as .env beside compose.yaml. No credentials are required.
MERRAN_IMAGE=ghcr.io/merran-app/merran:next
MERRAN_PORT=3000
TZ=UTC
PUID=1000
PGID=1000

# Optional: use your real hostname when adding HTTPS or a reverse proxy.
# MERRAN_PUBLIC_URL=https://food.example.com

# No DATABASE_URL: SQLite stays in ./data/app.
# The image makes a secret in /data; you do not need to invent one.
# Add AI and other optional credentials later in Merran's Settings.
