---
const base = import.meta.env.BASE_URL
---

<a class="merran-brand" href={base} aria-label="Merran home">
  <svg
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M9 11v13a15 15 0 0 0 30 0V11"></path>
    <path class="middle" d="M9 11l15 14 15-14"></path>
  </svg>
  <span class="word" translate="no">merr<span>a</span>n</span>
</a>
<style>
  .merran-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    white-space: nowrap;
    color: var(--foreground);
    font-size: 1.75rem;
    line-height: 1;
  }
  svg {
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    color: var(--primary);
  }
  .middle {
    stroke: var(--highlight);
  }
  .word {
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: -0.025em;
    font-variation-settings: "SOFT" 100;
  }
  .word span {
    color: var(--primary);
  }
</style>
