# Copy to .env next to compose.yaml. Nothing here is required: Merran runs on
# SQLite with every setting at its default.

# ---- Running it ----

# The port on this machine.
MERRAN_PORT=3000

# Your time zone, for log times.
TZ=UTC

# Who owns ./data/app on this machine. Merran drops to this user at startup.
PUID=1000
PGID=1000

# The address people reach Merran at, like https://merran.example.com. Used
# for invite links and sign-in. Set it once Merran is reachable from outside.
MERRAN_PUBLIC_URL=

# Proxies in front of Merran whose X-Forwarded-For can be believed, so rate
# limits see each person's real address: addresses or ranges, separated by
# commas. For a reverse proxy in Docker, often 172.16.0.0/12.
MERRAN_TRUSTED_PROXIES=

# Signs sessions and seals saved keys. Leave it empty and Merran makes one in
# ./data/app/secret, which is backed up with the rest of the data folder. To
# change it later, run `merran rotate-secret` (see docs/platform.md).
MERRAN_SECRET=

# How much the logs say: fatal, error, warn, info, debug or trace.
MERRAN_LOG_LEVEL=info

# Follow published releases, including alphas. Back up before updating.
MERRAN_IMAGE=ghcr.io/merran-app/merran:next
# Use a specific release tag to pin a version; `edge` follows commits to main.
# `latest` starts with stable releases from 0.1.0. Without MERRAN_IMAGE,
# compose.yaml falls back to next. The install guide has a shorter starter
# .env: https://merran.app/docs/get-started/install/#environment-variables

# Merran looks on GitHub for a newer release every 6 hours, for an Update
# badge for the server admin. `false` turns that off.
# MERRAN_UPDATE_CHECK=true

# ---- Optional parts ----
# Source development only: set in the shell before pnpm dev to test setup
# against a fresh temporary SQLite database each start. Normal data is untouched.
# Rejected in production and Docker; do not enable it in a deployment.
# MERRAN_DEV_SETUP=on

# The project compose.yaml contains optional services. Persist the profiles
# you want here so later pull/up/down commands include them too. For example:
# COMPOSE_PROFILES=postgres,voice
# postgres needs DATABASE_URL/password below; voice needs Kokoro's address.
# Add tunnel to the list when configuring the Cloudflare service.
# The self-contained host-manager examples do not use these profiles.
#
# Merran's module settings below can also be set in Settings, This server.
# Setting them here locks them there. COMPOSE_PROFILES is a Compose option,
# not a setting in Merran's interface.

# Send errors to your own Sentry, GlitchTip or Bugsink: the DSN it gives you.
# MERRAN_SENTRY_DSN=
# MERRAN_SENTRY_ENVIRONMENT=production
# The share of errors sent, from 0 to 1.
# MERRAN_SENTRY_SAMPLE_RATE=1

# Email transport (not released yet). Supports Resend or another SMTP service.
# Invitation and password-reset emails are still being built; test sending works.
# MERRAN_EMAIL_ENABLED=false
# MERRAN_SMTP_HOST=smtp.resend.com
# MERRAN_SMTP_PORT=465
# MERRAN_SMTP_SECURITY=tls
# MERRAN_SMTP_USERNAME=resend
# MERRAN_SMTP_PASSWORD=
# MERRAN_EMAIL_FROM=invites@example.com

# The anonymous daily summary for the Merran project. `off` turns it off for
# good; leave it unset to decide in Settings.
# MERRAN_TELEMETRY=

# Kokoro's address, with `--profile voice`, to read cook steps aloud.
# MERRAN_VOICE=kokoro
# MERRAN_KOKORO_URL=http://kokoro:8880

# ---- A Cloudflare Tunnel ----
# Start with `--profile tunnel`, after setting the token Cloudflare gives the
# tunnel, and MERRAN_PUBLIC_URL above to its public hostname. Cloudflare
# passes each person's address on, so set MERRAN_TRUSTED_PROXIES above to
# 172.16.0.0/12 too.

# CLOUDFLARE_TUNNEL_TOKEN=

# ---- Postgres instead of SQLite ----
# Start with `docker compose --profile postgres up -d`, after setting both of
# these. The password is letters and numbers only, because it goes in an
# address; `openssl rand -hex 24` makes a good one.

POSTGRES_PASSWORD=
# DATABASE_URL=postgres://merran:<the password above>@db:5432/merran
